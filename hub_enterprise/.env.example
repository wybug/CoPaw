# CoPaw Enterprise Skills Hub Configuration

# Server Configuration
HUB_HOST=0.0.0.0
HUB_PORT=9090
HUB_RELOAD=false
HUB_LOG_LEVEL=info

# Data Directory
HUB_DATA_DIR=./skills_data

# Private Key for Signing Skills
# Generate with: python -c "from hub_enterprise.signature import generate_key_pair; private, public = generate_key_pair(); print('Private:'); print(private); print('Public:'); print(public)"
HUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
